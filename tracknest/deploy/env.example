# Copy to .env.production (next to docker-compose.yml) and fill in. Never commit the real file.

# Your domain, pointed at this server (A record). Use "localhost" to try the stack on your machine.
DOMAIN=assets.example.com
APP_URL=https://assets.example.com

# Generate each with: openssl rand -hex 24
POSTGRES_PASSWORD=
APP_DB_PASSWORD=
CRON_SECRET=

# Outgoing email (Amazon SES Mumbai, Brevo, Zoho…). Empty = emails only printed to the app log.
SMTP_URL=
MAIL_FROM="TrackNest <alerts@example.com>"

BACKUP_KEEP_DAYS=14

# Optional "Sign in with Google" (see DEPLOY.md). Empty = no Google buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Windows office install only (docker-compose.windows.yml): major version of the PostgreSQL installed on Windows.
PG_MAJOR=17
