# App connects as the restricted role (RLS enforced, history is insert-only).
DATABASE_URL=postgres://tracknest_app:tracknest_dev@localhost:5432/tracknest
# Migrations run as the database owner.
DATABASE_ADMIN_URL=postgres://localhost:5432/tracknest
# Password given to the tracknest_app role by scripts/setup-db.sh
APP_DB_PASSWORD=tracknest_dev
