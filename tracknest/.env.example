# App connects as the restricted role (RLS enforced, history is insert-only).
DATABASE_URL=postgres://tracknest_app:tracknest_dev@localhost:5432/tracknest
# Migrations run as the database owner.
DATABASE_ADMIN_URL=postgres://localhost:5432/tracknest
# Password given to the tracknest_app role by scripts/setup-db.sh
APP_DB_PASSWORD=tracknest_dev

# Public URL used in links in emails and QR codes, e.g. https://assets.example.com
APP_URL=http://localhost:3000
# Outgoing email. Leave SMTP_URL empty in development: emails are printed to the server log.
# Example: smtps://USER:PASSWORD@email-smtp.ap-south-1.amazonaws.com:465
SMTP_URL=
MAIL_FROM="TrackNest <alerts@example.com>"
# Shared secret for the hourly alert job: POST /api/cron/alerts with "Authorization: Bearer <secret>"
CRON_SECRET=change-me-to-a-long-random-string
# Where uploaded photos and documents are stored. Put it on a backed-up volume in production.
UPLOAD_DIR=.data/uploads
# Optional "Sign in with Google". Create an OAuth client (type: Web application) in Google Cloud Console,
# with redirect URI <APP_URL>/auth/google/callback. Leave empty to hide the Google buttons.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
